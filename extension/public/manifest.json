{
  "manifest_version": 3,
  "name": "ApplyFlow Assistant",
  "description": "Review-first job application field matching and autofill.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://app.applyflow.example/*"
  ],
  "action": {
    "default_title": "Open ApplyFlow Assistant"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
